# ============================================
# Laravel Test Task - Environment Configuration
# ============================================

# Application Settings
APP_NAME="Laravel Test Task"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

# Localization
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance Mode
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP Settings
# PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ============================================
# Database Configuration
# ============================================

# SQLite (Default - Simple, file-based)
DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# MySQL (Recommended for production)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel_test_task
# DB_USERNAME=laravel_user
# DB_PASSWORD=your_secure_password_here

# PostgreSQL
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=laravel_test_task
# DB_USERNAME=laravel_user
# DB_PASSWORD=your_secure_password_here

# ============================================
# Session & Cache Configuration
# ============================================

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

# Cache (Database default, Redis recommended for production)
CACHE_STORE=database
# CACHE_PREFIX=laravel_test_

# Redis (Uncomment for production)
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# REDIS_CACHE_DB=1
# REDIS_SESSION_DB=2
# REDIS_QUEUE_DB=3

# ============================================
# Queue Configuration
# ============================================

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis

# ============================================
# Mail Configuration
# ============================================

MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=mailhog
# MAIL_PORT=1025
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_ENCRYPTION=null
# MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# AWS Services (Optional)
# ============================================

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================
# Vite/Asset Configuration
# ============================================

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ============================================
# Application-Specific Settings
# ============================================

# Jokes API Configuration
JOKES_API_URL=https://official-joke-api.appspot.com
JOKES_FETCH_INTERVAL=5 # minutes

# Analytics Settings
ANALYTICS_SESSION_TIMEOUT=30 # minutes
ANALYTICS_ANONYMIZE_IP=true
ANALYTICS_RESPECT_DNT=true

# Security Headers (Optional)
SECURITY_CSP_ENABLED=false
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000

# ============================================
# Deployment Notes
# ============================================
#
# 1. Generate application key:
#    php artisan key:generate
#
# 2. For production:
#    - Set APP_DEBUG=false
#    - Set APP_ENV=production
#    - Use HTTPS (update APP_URL)
#    - Use secure database credentials
#    - Consider using Redis for cache/session
#
# 3. Scheduled tasks require cron job:
#    * * * * * cd /path-to-project && php artisan schedule:run >> /dev/null 2>&1
#
# ============================================
